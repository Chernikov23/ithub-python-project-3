      "name": "Сны",
      "item": [
        {
          "name": "Все сны",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Код ответа 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "})",
                  "",
                  "var responseJson = pm.response.json()",
                  "",
                  "pm.test('Содержит поле \"dreams\", являющееся массивом', () => {",
                  "    pm.expect(responseJson).to.haveOwnProperty('dreams');",
                  "    pm.expect(responseJson.dreams).to.be.an('array');",
                  "})",
                  "",
                  "pm.test('Содержит численное поле \"dreams_count\"', () => {",
                  "    pm.expect(responseJson).to.haveOwnProperty('dreams_count');",
                  "    pm.expect(responseJson.dreams_count).to.be.a('number');",
                  "})",
                  "",
                  "if(responseJson.dreams.length){",
                  "    var dream = responseJson.dreams[0];",
                  "",
                  "    pm.test('Содержит поле \"created_at\" формата ISO8601', () => {",
                  "        pm.expect(dream).to.haveOwnProperty('created_at');",
                  "    })",
                  "",
                  "    pm.test('Содержит строковое поле \"description\"', () => {",
                  "        pm.expect(dream).to.haveOwnProperty('description');",
                  "        pm.expect(dream.description).to.be.a('string');",
                  "    })",
                  "",
                  "    pm.test('Содержит строковое поле \"author\"', () => {",
                  "        pm.expect(dream).to.haveOwnProperty('author');",
                  "        pm.expect(dream.author).to.be.an('string');",
                  "        pm.expect(dream.author).to.have.length.above(0);",
                  "    })",
                  "",
                  "} else {",
                  "    pm.test('Поле \"dreams_count\" равно нулю, если снов не найдено', () => {",
                  "        pm.expect(responseJson.dreams_count).to.be.eq(0);",
                  "    })",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
